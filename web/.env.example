# Cloud sync (Sign in with Google). Copy this file to web/.env and fill in the
# values from Firebase console > Project settings > Your apps > Web app.
# They're public by design (they end up in the site's JavaScript); the
# Firestore rules (firestore.rules) are what keep each account's data private.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# Only for testing on your own computer against `firebase emulators:start`:
# VITE_FIREBASE_EMULATOR=1
